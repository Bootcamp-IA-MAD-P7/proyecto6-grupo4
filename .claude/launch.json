{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "laliga-backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.backend.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "laliga-frontend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "http.server", "5173", "--directory", "app/frontend/public", "--bind", "127.0.0.1"],
      "port": 5173
    }
  ]
}
