# Database URL (PostgreSQL). Default: sqlite:///:memory: (no persistence)
DATABASE_URL=postgresql+psycopg://laliga:laliga@localhost:5432/laliga

# Secret key for JWT token signing. Default: random key (sessions lost on restart)
AUTH_SECRET_KEY=change-this-to-a-secure-random-string

# CORS origins (comma-separated). Default: * (all origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
